# --- Base de datos MySQL / MariaDB ---
# Sin DATABASE_URL el sitio usa datos de demostración (lib/data.ts).
DATABASE_URL=mysql://quecomer:quecomer@127.0.0.1:3306/quecomerenloja

# --- Asesor IA (tu propio servicio) ---
# Si se deja vacío, el chat usa un recomendador de ejemplo.
# El sitio hace POST con { message, history, location?, locale } y espera { reply }.
ADVISOR_API_URL=
# Se envía como "Authorization: Bearer ..." a tu asesor y se exige en GET /api/advisor/context.
ADVISOR_API_KEY=

# --- Sitio ---
# Número de WhatsApp del negocio GuIAloja, solo dígitos, sin "+" (ej: 5939XXXXXXXX)
NEXT_PUBLIC_BUSINESS_WHATSAPP=
NEXT_PUBLIC_SITE_URL=https://quecomerenloja.com
